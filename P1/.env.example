# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NÃO deve ir para o controle de versão (já está no .gitignore).

# Obrigatória para rodar os prompts. Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionais (os valores abaixo são os padrões).
# P1_MODELO=gemini-3.5-flash-lite
# P1_PENSAMENTO=minimal          # minimal | low | medium | high
# P1_TIMEOUT=60                  # segundos por tentativa
# P1_PAUSA=4                     # segundos entre chamadas (plano gratuito: 15 por minuto)
