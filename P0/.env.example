# Copie este arquivo para .env e preencha os valores.
# O arquivo .env NÃO deve ir para o controle de versão (já está no .gitignore).

# Obrigatória. Crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionais (os valores abaixo são os padrões).
# ATA_MODELO=gemini-3.5-flash-lite
# ATA_PENSAMENTO=minimal        # minimal | low | medium | high
# ATA_MAX_TOKENS=16000
# ATA_TIMEOUT=120               # segundos
# ATA_LIMITE_CARACTERES=50000
